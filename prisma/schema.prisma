generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum Role {
  USER
  ADMIN
  FACILITATOR
}

enum ProductType {
  COACHING
  MASTERMIND
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CreditGrantStatus {
  ACTIVE
  EXHAUSTED
  EXPIRED
  REVOKED
}

enum CreditTransactionType {
  PURCHASE
  RESERVATION
  RELEASE
  CONSUMPTION
  REFUND
  EXPIRATION
  ADMIN_ADJUSTMENT
}

enum LiveSessionStatus {
  DRAFT
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  RESERVED
  CANCELLED
  ATTENDED
  NO_SHOW
  REFUNDED
  EXCUSED
}

// ─── Auth (NextAuth) ─────────────────────────────────────

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  passwordHash     String?
  image            String?
  role             Role      @default(USER)
  stripeCustomerId String?   @unique
  timezone         String?   @default("America/Mexico_City")
  disabledAt       DateTime?
  adminNotes       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  purchases          Purchase[]
  creditGrants       CreditGrant[]
  creditTransactions CreditTransaction[]
  bookings           Booking[]
  sessionAccesses    SessionAccess[]
  passwordResetTokens PasswordResetToken[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Commerce ────────────────────────────────────────────

model ProductPackage {
  id              String      @id @default(cuid())
  name            String
  slug            String      @unique
  productType     ProductType
  creditQuantity  Int
  validityDays    Int?
  stripeProductId String?
  stripePriceId   String?
  price           Decimal     @db.Decimal(10, 2)
  currency        String      @default("usd")
  active          Boolean     @default(true)
  displayOrder    Int         @default(0)
  tagline         String?
  description     String?     @db.Text
  features        Json?
  featured        Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  purchases Purchase[]

  @@index([productType, active, displayOrder])
}

model Purchase {
  id                      String         @id @default(cuid())
  userId                  String
  packageId               String
  stripeCheckoutSessionId String?        @unique
  stripePaymentIntentId   String?
  amountPaid              Decimal?       @db.Decimal(10, 2)
  currency                String         @default("usd")
  status                  PurchaseStatus @default(PENDING)
  purchasedAt             DateTime?
  refundedAt              DateTime?
  // Snapshot so package edits don't rewrite history
  creditsGranted          Int?
  validityDays            Int?
  packageName             String?
  productType             ProductType?
  // Coaching: first-session Calendly scheduling
  calendlyEventUri        String?
  calendlyScheduledAt     DateTime?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  package     ProductPackage @relation(fields: [packageId], references: [id])
  creditGrant CreditGrant?

  @@index([userId, status])
  @@index([packageId])
}

model CreditGrant {
  id               String            @id @default(cuid())
  userId           String
  purchaseId       String?           @unique
  creditsGranted   Int
  creditsRemaining Int
  startsAt         DateTime          @default(now())
  expiresAt        DateTime
  status           CreditGrantStatus @default(ACTIVE)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchase     Purchase?           @relation(fields: [purchaseId], references: [id])
  transactions CreditTransaction[]
  bookings     Booking[]

  @@index([userId, status, expiresAt])
}

model CreditTransaction {
  id            String                 @id @default(cuid())
  userId        String
  creditGrantId String
  bookingId     String?
  amount        Int
  type          CreditTransactionType
  reason        String?
  createdBy     String?
  createdAt     DateTime               @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditGrant CreditGrant @relation(fields: [creditGrantId], references: [id], onDelete: Cascade)
  booking     Booking?    @relation(fields: [bookingId], references: [id])

  @@index([userId, createdAt])
  @@index([creditGrantId])
}

// ─── Mastermind live sessions ────────────────────────────

model LiveSession {
  id                    String            @id @default(cuid())
  title                 String
  slug                  String            @unique
  description           String?           @db.Text
  startsAt              DateTime
  endsAt                DateTime
  timezone              String            @default("America/Mexico_City")
  capacity              Int               @default(50)
  status                LiveSessionStatus @default(DRAFT)
  zoomJoinUrl           String?
  zoomMeetingId         String?
  recordingUrl          String?
  recordingAvailableAt  DateTime?
  materialsUrl          String?
  notes                 String?           @db.Text
  bookingClosesAt       DateTime?
  cancelDeadlineHours   Int?              @default(2)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  bookings        Booking[]
  sessionAccesses SessionAccess[]

  @@index([status, startsAt])
}

model Booking {
  id                   String        @id @default(cuid())
  userId               String
  liveSessionId        String
  creditGrantId        String
  status               BookingStatus @default(RESERVED)
  bookedAt             DateTime      @default(now())
  cancelledAt          DateTime?
  attendedAt           DateTime?
  checkedInBy          String?
  notes                String?
  zoomRegistrantId     String?
  zoomJoinUrl          String?
  zoomRegistrantEmail  String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  liveSession LiveSession         @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  creditGrant CreditGrant         @relation(fields: [creditGrantId], references: [id])
  transactions CreditTransaction[]

  @@unique([userId, liveSessionId])
  @@index([liveSessionId, status])
  @@index([creditGrantId])
}

model SessionAccess {
  id            String   @id @default(cuid())
  userId        String
  liveSessionId String
  grantedBy     String?
  reason        String?
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  liveSession LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)

  @@unique([userId, liveSessionId])
}

// ─── Stripe webhook idempotency ──────────────────────────

model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

// ─── Lightweight content keys (optional admin) ───────────

model SiteContent {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
